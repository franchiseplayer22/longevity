generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  nurse
  patient
  service
}

model User {
  id        String   @id @default(cuid())
  privyDid  String?  @unique
  email     String?  @unique
  name      String
  role      UserRole @default(patient)
  locale    String   @default("en-US")
  state     String?
  npi       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  threadMembers   ThreadMember[]
  messages        DirectMessage[]
  auditLogs       AuditLog[]
  reportsAuthored CareReport[]  @relation("ReportAuthor")
  reportsResolved CareReport[]  @relation("ReportResolver")
  tasksAssigned   PatientTask[] @relation("TaskAssignor")
}

model CareRecipient {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  reports     CareReport[]
  tasks       PatientTask[]
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  recipientId String
  familyKind  String
  role        String?
  createdAt   DateTime @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient CareRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([userId, recipientId])
  @@index([recipientId])
}

model Thread {
  id        String   @id @default(cuid())
  kind      String   @default("direct")
  topic     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ThreadMember[]
  messages DirectMessage[]
}

model ThreadMember {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  role      String?
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
}

model DirectMessage {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  body      String
  kind      String   @default("text")
  payload   Json?
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  subject   String?
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([action, createdAt])
  @@index([userId, createdAt])
}

model CareReport {
  id           String    @id @default(cuid())
  recipientId  String
  authorId     String
  kind         String
  title        String
  body         String
  status       String    @default("open")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  recipient  CareRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  author     User          @relation("ReportAuthor", fields: [authorId], references: [id])
  resolvedBy User?         @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@index([recipientId, status, createdAt])
}

model PatientTask {
  id           String    @id @default(cuid())
  recipientId  String
  assignedById String
  title        String
  subtitle     String
  kind         String
  threadId     String?
  messageId    String?
  completedAt  DateTime?
  painScore    Int?
  note         String?
  photoUrl     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  recipient  CareRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  assignedBy User          @relation("TaskAssignor", fields: [assignedById], references: [id])

  @@index([recipientId, completedAt, createdAt])
}
